# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Turso Database (from turso.tech)
TURSO_URL=libsql://your-db-name-yourname.turso.io
TURSO_TOKEN=your_turso_token_here

# Admin Dashboard API Key (choose any strong password)
ADMIN_API_KEY=choose_a_strong_password_here

# Your Render.com URL (after deployment)
WEBHOOK_URL=https://your-app-name.onrender.com

# Webhook secret (keep this)
WEBHOOK_SECRET=mysecret123

# Port
PORT=3000

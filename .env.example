# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Turso Database (from turso.tech)
TURSO_URL=libsql://your-db-name-yourname.turso.io
TURSO_TOKEN=your_turso_token_here

# Admin Dashboard API Key (choose any strong password)
ADMIN_API_KEY=choose_a_strong_password_here

# Your Railway URL (after deployment)
WEBHOOK_URL=https://your-app.up.railway.app

# Webhook secret — اختر قيمة عشوائية قوية، لا تتركها فارغة
WEBHOOK_SECRET=choose_a_random_secret_here

# Port
PORT=3000
